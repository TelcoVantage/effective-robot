{
  "name": "Get Conversation Drop Details",
  "integrationType": "purecloud-data-actions",
  "actionType": "custom",
  "config": {
    "request": {
      "requestUrlTemplate": "/api/v2/conversations/${input.CONVERSATION_ID}",
      "requestType": "GET",
      "headers": {},
      "requestTemplate": "${input.rawRequest}"
    },
    "response": {
      "translationMap": {
        "errorCodes": "$.participants[*].attributes.ErrorCode",
        "errorMessages": "$.participants[*].attributes.ErrorMessage",
        "queueNames": "$.participants[?(@.purpose=='acd')].name",
        "agentNames": "$.participants[?(@.purpose=='agent')].name",
        "startTime": "$.startTime",
        "endTime": "$.endTime",
        "callErrorCodes": "$.participants[*].calls[*].errorInfo.code",
        "callErrorMessages": "$.participants[*].calls[*].errorInfo.message"
      },
      "translationMapDefaults": {
        "errorCodes": "[]",
        "errorMessages": "[]",
        "queueNames": "[]",
        "agentNames": "[]",
        "startTime": "\"\"",
        "endTime": "\"\"",
        "callErrorCodes": "[]",
        "callErrorMessages": "[]"
      },
      "successTemplate": "#set($attrCode = $successTemplateUtils.firstFromArray(\"${errorCodes}\", \"${esc.quote}${esc.quote}\"))\n#set($attrMsg = $successTemplateUtils.firstFromArray(\"${errorMessages}\", \"${esc.quote}${esc.quote}\"))\n#set($platCode = $successTemplateUtils.firstFromArray(\"${callErrorCodes}\", \"${esc.quote}${esc.quote}\"))\n#set($platMsg = $successTemplateUtils.firstFromArray(\"${callErrorMessages}\", \"${esc.quote}${esc.quote}\"))\n#set($none = '\"\"')\n{\n  \"errorCode\": #if($attrCode != $none)${attrCode}#else${platCode}#end,\n  \"errorMessage\": #if($attrMsg != $none)${attrMsg}#else${platMsg}#end,\n  \"queueName\": ${successTemplateUtils.firstFromArray(\"${queueNames}\", \"${esc.quote}${esc.quote}\")},\n  \"agentName\": ${successTemplateUtils.firstFromArray(\"${agentNames}\", \"${esc.quote}${esc.quote}\")},\n  \"callStartTime\": #if($startTime)${startTime}#else\"\"#end,\n  \"callEndTime\": #if($endTime)${endTime}#else\"\"#end\n}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "title": "Get Conversation Drop Details input",
        "type": "object",
        "properties": {
          "CONVERSATION_ID": {
            "type": "string",
            "description": "Genesys Cloud conversation ID"
          }
        },
        "additionalProperties": true
      }
    },
    "output": {
      "successSchema": {
        "title": "Get Conversation Drop Details output",
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          },
          "callStartTime": {
            "type": "string"
          },
          "callEndTime": {
            "type": "string"
          },
          "queueName": {
            "type": "string"
          },
          "agentName": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "secure": false
}